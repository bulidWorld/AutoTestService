  <xs:element name="task">
    <xs:annotation>
      <xs:documentation xml:lang="zh">任务执行顺序：固定参数 → main → finally → 终态。总节点至多 1000，业务补充校验。禁止 DTD、实体和外部引用，文件至多 5 MiB，导入不发请求。</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="parameters" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="zh">可选的全局参数容器，只能出现一次，必须位于所有 taskStep 之前。type="fixed" 始终按字面量处理，即使 value 为 generateUUID() 也不执行。type="function" 显式调用白名单内置函数，目前仅支持 valueType="string" 且 value 完整填写 generateUUID()（区分大小写、无参数、无额外空白）。在每次 task 执行初始化时生成标准带连字符 UUID v4 字符串，同次执行内多个 taskStep（含并发及 finally）引用同名参数共享结果；不同 task、同一 task 重新执行分别生成。导入、保存、复制、排队均保留函数文本，不提前求值；预览独立生成，不复用正式执行结果。不同参数声明分别生成。示例：&lt;parameter type="function" valueType="string"&gt;&lt;name&gt;task_uuid&lt;/name&gt;&lt;value&gt;generateUUID()&lt;/value&gt;&lt;/parameter&gt;；后续用 &lt;parameter&gt;task_uuid&lt;/parameter&gt; 引用。禁止任意代码、未知函数及函数参数；object/array 嵌套文本不执行。响应提取参数在对应 rest 的 extractParam 中声明。</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="parameter" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation xml:lang="zh">全局参数（fixed 字面量或 function 内置函数），可重复声明不同名字。例如 &lt;parameter type="fixed" valueType="integer"&gt;&lt;name&gt;id&lt;/name&gt;&lt;value&gt;42&lt;/value&gt;&lt;/parameter&gt;。后续 kv 可通过 parameter 子元素引用；字面值恰为 {参数名} 时也会按现有绑定规则引用全局参数。</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="pair">
                      <xs:attribute name="type" use="required">
                        <xs:annotation>
                          <xs:documentation xml:lang="zh">必填：fixed 表示字面量，function 表示执行白名单内置函数。值类型使用 valueType；响应来源使用 extractParam。</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:enumeration value="fixed"/>
                            <xs:enumeration value="function"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="taskStep" type="MainTaskStep" minOccurs="1" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation xml:lang="zh">至少一个 main 根节点；按 order 升序执行，失败后跳过后续主流程并尝试清理。</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="finally" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="zh">可选且最多一次，至少一个 rest/wait/compute/sql；不允许 parallel；清理 REST 可声明 extractParam。无论 main 成功或失败，进程正常时按顺序尝试全部清理，单步失败不阻断后续清理。</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="taskStep" type="CleanupTaskStep" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation xml:lang="zh">清理步骤，缺失已发布输入则失败且不发请求，继续后续清理。</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
          <xs:unique name="finallyOrder">
            <xs:annotation>
              <xs:documentation xml:lang="zh">仅检查本容器直属 taskStep 的 order 唯一；不同容器可重复。</xs:documentation>
            </xs:annotation>
            <xs:selector xpath="taskStep"/>
            <xs:field xpath="@order"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="zh">必填任务名称，同项目唯一，去除首尾空白，不超过 120 字符。</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="nonEmpty">
            <xs:maxLength value="120"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
    <xs:unique name="uniqueOrder">
      <xs:annotation>
        <xs:documentation xml:lang="zh">仅检查本容器直属 taskStep 的 order 唯一；不同容器可重复。</xs:documentation>
      </xs:annotation>
      <xs:selector xpath="taskStep"/>
      <xs:field xpath="@order"/>
    </xs:unique>
  </xs:element>
</xs:schema>
